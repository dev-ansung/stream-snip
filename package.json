{
  "name": "stream-snip",
  "version": "1.0.0",
  "description": "Lossless HLS Video & Audio Clipper Chrome Extension",
  "license": "MIT",
  "author": "dev-ansung",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-ansung/stream-snip.git"
  },
  "homepage": "https://github.com/dev-ansung/stream-snip#readme",
  "bugs": {
    "url": "https://github.com/dev-ansung/stream-snip/issues"
  },
  "keywords": [
    "hls",
    "m3u8",
    "chrome-extension",
    "video-clipper",
    "steganography",
    "mp4",
    "transmuxer"
  ],
  "scripts": {
    "build": "node scripts/build-zip.js",
    "package": "node scripts/build-zip.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "mux.js": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.24.0"
}
