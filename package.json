{
  "name": "stego-clip-extension",
  "version": "1.0.0",
  "description": "Standalone Chrome Extension for M3U8 Stream Interception & Time-Range Clipping with Stego Decoding",
  "license": "MIT",
  "author": "dev-ansung",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-ansung/stego-clip-extension.git"
  },
  "homepage": "https://github.com/dev-ansung/stego-clip-extension#readme",
  "bugs": {
    "url": "https://github.com/dev-ansung/stego-clip-extension/issues"
  },
  "keywords": [
    "hls",
    "m3u8",
    "chrome-extension",
    "video-clipper",
    "steganography",
    "mp4",
    "transmuxer"
  ],
  "scripts": {
    "build": "node scripts/build-zip.js",
    "package": "node scripts/build-zip.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "mux.js": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.7"
  }
}
